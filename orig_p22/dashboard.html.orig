    trades: []
  };
  S.metrics = 'bot_errors_total{bot="tao_momentum"} 0\nbot_errors_total{bot="btc_bounce"} 0\nbot_errors_total{bot="inj_liquidity"} 1\nbot_errors_total{bot="gold_dca"} 0\nbot_uds_active{bot="tao_momentum"} 1\nbot_uds_active{bot="btc_bounce"} 1\nbot_uds_active{bot="inj_liquidity"} 0\nbot_uds_active{bot="gold_dca"} 0\n';
  S.data.trades = [...(S.data.closes||[])].reverse();
  $('connPill').classList.remove('live','down');
  $('connPill').classList.add('demo');
  $('connText').textContent = 'DEMO';try{setConn('DEMO')}catch(e){};
  renderAll();
}

function toggleAuto(){
  S.auto = !S.auto;
  $('btnAuto').textContent = S.auto ? '⏸ PAUSE' : '▶ AUTO';
  if (S.auto) startTimer();
  else clearInterval(S.timer);
}

function startTimer(){
  clearInterval(S.timer);
  if (S.auto) S.timer = setInterval(refresh, 5000);
}

function showTab(t){
  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('active', b.dataset.t === t));
  if (t === 'chart') {
    $('pane-chart').style.display = 'block';
    $('pane-chart').scrollIntoView({behavior:'smooth', block:'start'});
    if (!S.charts.price) loadPriceChart();
  } else {
    $('pane-chart').style.display = 'none';
    window.scrollTo({top:0, behavior:'smooth'});
  }
}

/* Keyboard shortcuts */
document.addEventListener('keydown', e => {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
  // Ctrl+Z = undo, Ctrl+Y or Ctrl+Shift+Z = redo
  if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) {
    if (e.shiftKey) { e.preventDefault(); redoDraw(); }
    else            { e.preventDefault(); undoDraw(); }
    return;
  }
  if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || e.key === 'Y')) {
    e.preventDefault(); redoDraw(); return;
  }
  if (e.ctrlKey || e.metaKey) return; // don't intercept other Ctrl+X combos
  if (e.key === 'r' || e.key === 'R') { e.preventDefault(); refresh(); }
  else if (e.key === ' ') { e.preventDefault(); toggleAuto(); }
  else if (e.key === 't' || e.key === 'T') { e.preventDefault(); toggleTheme(); }
  else if (e.key === '1') showTab('overview');
  else if (e.key === '2') showTab('chart');
  else if (e.key === '3') showTab('positions');
  else if (e.key === '4') showTab('trades');
  else if (e.key === 'Escape') {
    document.querySelectorAll('.qo-backdrop').forEach(el => el.remove());
    if (S.activeTool !== 'cursor') setDrawTool('cursor');
  }
});

function renderAll(){
  renderTicker(); renderBotTree(); renderWatchlist(); renderLossLimits();
  renderHero(); renderBotGrid(); renderPositions(); renderTrades();
  renderLog(); renderStatus(); updateSelects();
  renderPnlChart(); renderBotsChart();
  renderOrderbook();
  renderMTFMatrix(); renderMoneyFlow(); renderRiskPlanet(); renderSignalProbability();
  updateUndoRedoButtons();
  // Re-render existing drawings after chart redraw
  setTimeout(() => renderDrawings(), 100);
}

async function init(){
  // Apply saved theme already done above
  try {
    await refresh();
    if (!S.data) throw new Error('no backend');
  } catch(e) {
    loadDemo();
  }
  // Setup drawing handlers once
  setupDrawingHandlers();
  loadDrawings();
}
init(); startTimer();
</script>
</body>
</html>
